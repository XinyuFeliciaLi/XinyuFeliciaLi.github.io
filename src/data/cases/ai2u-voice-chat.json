    {
     "t": "h3",
     "runs": [
      {
       "s": "Key Insights"
      }
     ]
    },
    {
     "t": "card",
     "items": [
      {
       "t": "h4",
       "runs": [
        {
         "s": "01 |  Voice input carried the experience"
        }
       ]
      },
      {
       "t": "p",
       "runs": [
        {
         "s": "Most users preferred voice to text. Speaking to an NPC felt more immersive, so voice led the redesign."
        }
       ]
      }
     ]
    },
    {
     "t": "card",
     "items": [
      {
       "t": "h4",
       "runs": [
        {
         "s": "02 |  The gap was feedback, not accuracy"
        }
       ]
      },
      {
       "t": "p",
       "runs": [
        {
         "s": "Users saw their words mistranscribed, but the LLM parsed imperfect transcripts fine. They needed to see the game listening and mistakes fixable"
        }
       ]
      }
     ]
    },
    {
     "t": "card",
     "items": [
      {
       "t": "h4",
       "runs": [
        {
         "s": "03 | Controls did not signal what was available"
        }
       ]
      },
      {
       "t": "p",
       "runs": [
        {
         "s": "Users could not tell which controls were live at any moment. "
        }
       ]
      }
     ]
    },
    {
     "t": "card",
     "band": 1,
     "items": [
      {
       "t": "img",
       "src": "ai2u-voice-chat/008.png",
       "w": 184,
       "h": 184,
       "alt": "03 | Controls did not signal what was available"
      },
      {
       "t": "h3",
       "runs": [
        {
         "s": "How Might We"
        }
       ],
       "center": 1
      },
      {
       "t": "p",
       "runs": [
        {
         "s": "How might we show users the system heard them, and let them fix it when it gets them wrong, without touching the backend?"
        }
       ],
       "center": 1
      }
     ],
     "center": 1
    }
