     ]
    },
    {
     "t": "p",
     "list": "ul",
     "lines": [
      [
       {
        "s": "Voice gave no signal it was listening and no way to fix a bad transcript."
       }
      ],
      [
       {
        "s": "Text had no visible send action."
       }
      ]
     ]
    },
    {
     "t": "h2",
     "runs": [
      {
       "s": "Goal"
      }
     ]
    },
    {
     "t": "p",
     "runs": [
      {
       "s": "Make voice and text input feel reliable, without changing the underlying system."
      }
     ]
    },
    {
     "t": "h2",
     "runs": [
      {
       "s": "Impact"
      }
     ]
    },
    {
     "t": "p",
     "runs": [
      {
       "s": "The input system shipped in Q2 2025. Internal tickets on the input feature dropped 54% after launch."
      }
     ]
    }
