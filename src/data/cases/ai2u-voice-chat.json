          },
          {
           "t": "caption",
           "runs": [
            {
             "s": "Making the transcript editable introduced a new failure. Users clicked into the text field while still talking, which cut off the voice input mid-sentence."
            }
           ]
          }
         ]
        },
        {
         "t": "card",
         "items": [
