     "center": 1
    },
    {
     "t": "h3",
     "runs": [
      {
       "s": " Post-Session Summary"
      }
     ],
     "center": 1
    },
    {
     "t": "card",
     "items": [
      {
       "t": "img",
       "src": "ai2u-design-snapshots/001.png",
       "w": 913,
       "h": 313,
       "alt": "Post-Session Summary"
      },
      {
       "t": "row",
       "cols": [
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "Overview"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "Led the iteration cycle to improve readability and clarity for the post-session summary screen so users could follow the overall experience flow."
            }
           ]
          }
         ]
        },
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "Problem"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "A lack of visual hierarchy left users unable to tell what the session information meant, and the AI generated overview requires processing time the screen had to design around."
            }
           ]
          }
         ]
        },
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "UX Approach"
            }
           ]
          },
          {
           "t": "p",
           "list": "ul",
           "lines": [
            [
             {
              "s": "Applied Gestalt grouping and visual hierarchy to organize content into scannable sections"
             }
            ],
            [
             {
              "s": "Sequenced the entrance animation so session stats resolve first, giving the AI overview room to process before it lands"
             }
            ]
           ]
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "t": "h3",
     "runs": [
      {
       "s": "Level Overview"
      }
     ],
