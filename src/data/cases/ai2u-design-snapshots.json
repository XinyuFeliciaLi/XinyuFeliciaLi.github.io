          }
         ]
        },
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "Problem"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "Inconstent interaction patterns increased the learning curve, and personality settings lived in a separate modal, splitting how the companion looks from how it behaves."
            }
           ]
          }
         ]
        },
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "UX Approach"
            }
           ]
          },
          {
           "t": "p",
           "list": "ul",
           "lines": [
            [
             {
              "s": "Applied a consistency heuristic to align interaction patterns with the shop"
             }
            ],
            [
             {
              "s": "Consolidated appearance and personality into one panel so trait changes read against the model in view"
             }
            ]
           ]
          }
         ]
        }
       ]
      }
     ]
    },
    {
