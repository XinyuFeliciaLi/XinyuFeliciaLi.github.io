           "t": "h4",
           "runs": [
            {
             "s": "I'd negotiate scope earlier\n"
            }
           ],
           "center": 1
          },
          {
           "t": "small",
           "runs": [
            {
             "s": "New requests arrived mid cycle with high priority attached, often close to a deadline. I absorbed them into the current sprint. Now I surface the tradeoff at intake, so scope decisions happen before the work starts instead of after."
            }
           ],
           "center": 1
          }
