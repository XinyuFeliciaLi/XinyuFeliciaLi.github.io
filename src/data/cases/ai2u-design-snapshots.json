            {
             "s": "Challenge"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "After early access, feedback from business, game design, and the community left every core screen with an open problem to resolve before V1.0."
            }
           ]
          },
          {
           "t": "h3",
           "runs": [
            {
             "s": "Goal"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "Make every screen legible on its own, so players know what they are looking at, while the interface carries the platform's business goals into launch."
            }
           ]
          },
          {
           "t": "h3",
           "runs": [
            {
             "s": "Impact"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "Owned interaction design across 50+ screens from pre early access through the V1.0 launch, which shipped with an 88% positive Steam rating across 2,000+ reviews."
            }
           ]
          }
         ]
        }
       ]
