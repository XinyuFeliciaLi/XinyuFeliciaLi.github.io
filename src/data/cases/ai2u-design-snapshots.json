           ]
          },
          {
           "t": "p",
           "list": "ul",
           "lines": [
            [
             {
              "s": "Applied the endowment effect through a try on feature, letting users visualize ownership before purchase"
             }
            ],
            [
             {
              "s": "Grouped items by category to support browsing"
             }
            ]
           ]
          }
         ]
        }
