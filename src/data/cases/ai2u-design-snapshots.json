    {
     "t": "h3",
     "runs": [
      {
       "s": "What I’d learned from these projects"
      }
     ]
    },
    {
     "t": "row",
     "cols": [
      {
       "w": 363,
       "items": [
        {
         "t": "card",
         "items": [
          {
           "t": "img",
           "src": "ai2u-design-snapshots/007.png",
           "w": 40,
           "h": 40,
           "alt": ""
          },
          {
           "t": "h4",
           "runs": [
            {
             "s": "Each team hears a different version of the same screen"
            }
           ],
           "center": 1
          },
          {
           "t": "small",
           "runs": [
            {
             "s": "Engineering read the shop as data and system behavior. Marketing read the same layout as placement and color. I learned to present one design in two rationales, which got decisions approved in a single review instead of a second round."
            }
           ],
           "center": 1
          }
         ],
         "center": 1
        }
       ]
      },
      {
       "w": 363,
       "items": [
