           ]
          }
         ]
        },
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "Problem"
            }
           ]
          },
          {
           "t": "p",
           "runs": [
            {
             "s": "The screen presented content without visual hierarchy, and incoming requirements added more information to an undifferentiated layout."
            }
           ]
          }
         ]
        },
        {
         "w": 250,
         "items": [
          {
           "t": "label",
           "runs": [
            {
             "s": "UX Approach"
            }
           ]
          },
          {
           "t": "p",
           "list": "ul",
           "lines": [
            [
             {
              "s": "Established visual hierarchy to organize existing content"
             }
            ],
            [
             {
              "s": "Integrated equip items into the structure"
             }
            ]
           ]
          }
         ]
        }
       ]
      }
