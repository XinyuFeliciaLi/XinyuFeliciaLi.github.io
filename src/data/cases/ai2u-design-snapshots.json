    {
     "t": "p",
     "runs": [
      {
       "s": "This collection highlights my focus on interaction design in AI2U, an AI-powered companion platform. 2D illustrations and 3D assets are created by dedicated Concept and 3D artists."
      }
     ]
    },
    {
