---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
	<section class="container">
		<h1 data-reveal>Contact</h1>
		<p class="prose" data-reveal>
			<!-- PLACEHOLDER — confirm the real contact email before shipping. -->
			Get in touch at <a class="link-underline" href="mailto:hello@feliciali.com">hello@feliciali.com</a>.
		</p>
	</section>
</BaseLayout>

<style>
	section {
		padding-block: var(--space-16);
		max-width: 42rem;
	}

	.prose {
		color: var(--color-ink-muted);
		font-size: var(--text-lg);
	}
</style>
