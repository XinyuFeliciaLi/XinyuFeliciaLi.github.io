---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import HeroMorph from '../components/sandbox/HeroMorph.astro';
---
<BaseLayout title="Home">
  <section class="hero"><HeroMorph controls={false} /></section>
  <HomeSections />
</BaseLayout>
<style>
.hero { width:100%; padding:var(--space-4) var(--space-4) 0; margin-inline:auto; }
.hero > :global(*) { width:100%; margin-inline:auto; min-width:0; }
</style>
