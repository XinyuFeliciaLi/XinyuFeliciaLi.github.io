---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const caseStudies = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Home">
	<section class="hero container">
		<h1 class="hero-title" data-reveal>Felicia Li designs products people trust on the first try.</h1>
		<p class="hero-sub" data-reveal>Senior product designer — UX/UI, systems, and the occasional pixel loop.</p>
	</section>

	<section class="container work-preview">
		<h2 data-reveal>Selected work</h2>
		<ul class="work-list">
			{
				caseStudies.map((study) => (
					<li data-reveal>
						<a class="work-card card-hover" href={`/work/${study.id}/`}>
							<span class="work-card__client">{study.data.client}</span>
							<span class="work-card__title">{study.data.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: var(--space-24) var(--space-16);
	}

	.hero-sub {
		max-width: 40ch;
		color: var(--color-ink-muted);
		font-size: var(--text-lg);
	}

	.work-preview {
		padding-block: var(--space-16);
	}

	.work-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-6);
	}

	.work-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-8);
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: var(--radius-lg);
		text-decoration: none;
	}

	.work-card__client {
		color: var(--color-terracotta);
		font-size: var(--text-sm);
		font-weight: 600;
	}

	.work-card__title {
		font-family: var(--font-heading);
		font-size: var(--text-xl);
	}
</style>
