---
<div class="workflow-scroll" tabindex="0" role="region" aria-label="Digital tool workflow. Scroll horizontally on smaller screens.">
 <svg viewBox="-5 -5 762 479" class="museum-workflow" aria-label="Original digital tool workflow with input and output branches, three edit return paths, and saved-project playback">
  <defs><marker id="museum-arrow" markerWidth="7" markerHeight="9" refX="6" refY="4.5" orient="auto"><path d="M1 1 L6 4.5 L1 8" fill="none" stroke="#ed9cc3" stroke-width="1" /></marker></defs>
  <g fill="none" stroke="#ed9cc3" stroke-width="1" marker-end="url(#museum-arrow)">{paths.map(d=><path d={d}/>)}</g>
  {nodes.map(([x,y,w,h,lines],i)=><g class="workflow-node" style={`--delay:${i*35}ms`}><rect x={x} y={y} width={w} height={h} rx="17" fill="#fdf3f7"/><text x={x+w/2} y={y+h/2-(lines.length-1)*10+4} text-anchor="middle">{lines.map((line,j)=><tspan x={x+w/2} dy={j?20:0}>{line}</tspan>)}</text></g>)}
  {[250,333,423].map(x=><text x={x} y="339" class="edit">Edit</text>)}
 </svg>
</div>
<style>
 .workflow-scroll { overflow-x:auto; width:100%; }
 .museum-workflow { display:block; width:100%; min-width:700px; }
 text { font:400 12px var(--font-sans); fill:var(--color-ink); }
 .edit { font-size:11px; fill:#db7aac; }
 @media(prefers-reduced-motion:no-preference) {
  :global(.museum-diagram[data-panel-motion]) .workflow-node { opacity:0; transition:opacity 650ms ease; transition-delay:var(--delay); }
  :global(.museum-diagram[data-panel-visible]) .workflow-node { opacity:1; }
 }
</style>
