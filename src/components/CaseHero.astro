---
// Shared compact hero band; artwork is centered in the space below the navigation.
import AnimatedImage from './AnimatedImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	background?: string;
}

const { image, alt, background } = Astro.props;
---

<section class="case-hero" style={background ? `--hero-background: ${background}` : undefined}>
	<AnimatedImage
		class="case-hero__art"
		style={`--hero-art-ratio: ${image.width / image.height}`}
		data-reveal
		src={image}
		alt={alt}
		loading="eager"
		fetchpriority="high"
		widths={[480, 800, 1240]}
		sizes="(max-width: 40rem) 90vw, 620px"
	/>
</section>

<style>
	.case-hero {
		--hero-height: clamp(19rem, 27.5vw, 33rem);
		/* Header: 24px top inset + 24px padding + 38px link + 2px border. */
		--hero-nav-bottom: 88px;
		--hero-art-inset: 16px;
		height: var(--hero-height);
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		place-items: center;
		padding: calc(var(--hero-nav-bottom) + var(--hero-art-inset)) var(--space-6) var(--hero-art-inset);
		/* Light canvas with a gently drifting dot grid. */
		--grid-gap: 24px;
		--grid-dot: radial-gradient(circle, rgb(37 55 70 / 0.16) 1.2px, transparent 1.6px);
		--shift-x: 0px;
		--shift-y: 0px;
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background-color: var(--hero-background, rgb(247 247 248 / 0.5));
		background-image: var(--grid-dot);
		background-size: var(--grid-gap) var(--grid-gap);
		background-position: var(--shift-x) var(--shift-y);
		border-radius: 0 0 var(--radius-lg) var(--radius-lg);
		transition: background-position var(--duration-long) var(--ease-reveal);
	}

	.case-hero :global(.case-hero__art) {
		position: relative;
		/* Bound both dimensions together so GIF overlays and the poster share one scale. */
		width: min(100%, 38.75rem, calc((var(--hero-height) - var(--hero-nav-bottom) - 2 * var(--hero-art-inset)) * var(--hero-art-ratio)));
		height: auto;
		max-width: 100%;
		object-fit: contain;
	}
	@media (max-width: 40rem) {
		/* Header: 16px top inset + 16px padding + 44px control + 2px border. */
		.case-hero { --hero-nav-bottom: 78px; }
	}
</style>

<script>
	// Slight interaction only: fine pointers, and nothing when reduced motion is requested.
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
	let cleanup: (() => void) | undefined;

	function setupHeroInteraction() {
		cleanup?.();
		if (!canHover.matches || reduce.matches) return;
		const controller = new AbortController();
		const resets: (() => void)[] = [];
		document.querySelectorAll<HTMLElement>('.case-hero').forEach((hero) => {
			let frame = 0;
			hero.addEventListener('pointermove', (e) => {
				cancelAnimationFrame(frame);
				frame = requestAnimationFrame(() => {
					const r = hero.getBoundingClientRect();
					const x = e.clientX - r.left;
					const y = e.clientY - r.top;
					// Gentle background drift; artwork stays still.
					hero.style.setProperty('--shift-x', `${(0.5 - x / r.width) * 12}px`);
					hero.style.setProperty('--shift-y', `${(0.5 - y / r.height) * 12}px`);
				});
			}, { signal: controller.signal });
			const reset = () => {
				cancelAnimationFrame(frame);
				hero.style.setProperty('--shift-x', '0px');
				hero.style.setProperty('--shift-y', '0px');
			};
			resets.push(reset);
			hero.addEventListener('pointerleave', reset, { signal: controller.signal });
		});
		cleanup = () => { controller.abort(); resets.forEach(reset => reset()); };
	}
	setupHeroInteraction();
	document.addEventListener('astro:page-load', setupHeroInteraction);
	document.addEventListener('astro:before-swap', () => cleanup?.());
	reduce.addEventListener('change', setupHeroInteraction);
	canHover.addEventListener('change', setupHeroInteraction);
</script>

