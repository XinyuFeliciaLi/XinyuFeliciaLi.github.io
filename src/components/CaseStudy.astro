---
// One case study page: shared hero band, then the Figma sections in a 750px reading column.
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseHero from './CaseHero.astro';
import Blocks from './Blocks.astro';
import CaseSectionNav from './CaseSectionNav.astro';
import { caseContent, heroImage, type Block, type CaseEntry } from '../data/cases';
import '../styles/case-study.css';
import '../styles/case-study-card-layouts.css';
import '../styles/case-study-motion.css';

interface Props {
	entry: CaseEntry;
}

const { entry } = Astro.props;
const content = caseContent(entry.slug);

// Figma nests each section as an intro (eyebrow / heading / body) followed by sub-blocks, each
// headed by an h2, h3 or eyebrow. Split the flat block list at those headings (an eyebrow sticks to
// the heading after it) so sub-blocks can be spaced apart like the Figma frames.
const isHeading = (b?: Block) => b?.t === 'h2' || b?.t === 'h3';
const startsGroup = (items: Block[], i: number) => {
	const prev = items[i - 1]?.t;
	if (items[i].band || items[i - 1]?.band) return true;
	if (items[i].t === 'h4' && /^0?\d\s*[·|]/.test(items[i].runs?.map((r) => r.s).join('') ?? '')) return true;
	if (isHeading(items[i])) return prev !== 'eyebrow';
	// a showcase image / video after a card row is its own block (Fortune Kid's show reel)
	if (['img', 'video'].includes(items[i].t)) return prev === 'row' || prev === 'card';
	return items[i].t === 'eyebrow' && prev !== 'eyebrow' && !isHeading(items[i - 1]);
};
const groups = (items: Block[]) =>
	items.reduce<Block[][]>((out, b, i) => {
		if (i === 0 || startsGroup(items, i)) out.push([]);
		out[out.length - 1].push(b);
		return out;
	}, []);
// "Final Design" sections (eyebrow or heading) get a lighter card background
const isFinal = (items: Block[]) =>
	items.slice(0, 2).some((b) => b.runs?.some((r) => /final design/i.test(r.s)));
---

<BaseLayout title={content.title} description={entry.cardTitle}>
	<CaseHero image={heroImage(entry.slug)} alt={entry.heroAlt} />
	{entry.slug === 'fortune-kid' && <CaseSectionNav sections={content.sections.filter(s => s.name !== 'How Might We').map(s => ({ id: `section-${s.id.replace(':', '-')}`, label: s.name === 'Refine' ? 'Iteration' : s.name }))} />}
	<article class:list={['container container--prose case', `case--${entry.slug}`, { 'case--featured': entry.kind === 'project' }]}>
		{
			content.sections.map((section) => (
				<section id={`section-${section.id.replace(':', '-')}`} data-figma-node={section.id} class:list={['case-section', { 'case-section--final': isFinal(section.items) }]} data-panel-entrances>
					{groups(section.items).map((group) => (
						<div class:list={['case-group', { 'case-group--insights': group[0]?.runs?.some((run) => run.s.trim() === 'Key Insights') }]}>
							<Blocks items={group} />
						</div>
					))}
				</section>
			))
		}
	</article>
</BaseLayout>

<script>
	let panelObserver: IntersectionObserver | undefined;
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	function setupPanelEntrances() {
		panelObserver?.disconnect();
		if (reducedMotion.matches || !('IntersectionObserver' in window)) return;
		const panelSelector = '.block-card, .block-img, .block-video, .block-showreel, .block-col--media-panel, .workflow-canvas, .iteration-comparison, .competitive-analysis';
		// Animate each outer surface once, without nested card reveals.
		const panels = [...document.querySelectorAll<HTMLElement>('[data-panel-entrances]')]
			.flatMap(section => [...section.querySelectorAll<HTMLElement>(panelSelector)])
			.filter(panel => !panel.parentElement?.closest(panelSelector))
			.filter(panel => !panel.matches('.block-card--metadata, .block-card--details') && !panel.querySelector('.block-row--metadata'));
		panelObserver = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.setAttribute('data-panel-visible', '');
				panelObserver?.unobserve(entry.target);
			}
		}, { threshold: 0, rootMargin: '0px 0px -120px 0px' });
		for (const panel of panels) {
			panel.querySelectorAll<HTMLElement>('.block-img, .workflow-layer, .iteration-image, .competitive-analysis img, .showreel-media').forEach(image => {
				if (!image.hasAttribute('data-panel-media')) image.style.setProperty('--media-rest-opacity', getComputedStyle(image).opacity);
				image.setAttribute('data-panel-media', '');
			});
			panel.setAttribute('data-panel-motion', '');
			panelObserver.observe(panel);
		}
	}
	setupPanelEntrances();
	document.addEventListener('astro:page-load', setupPanelEntrances);
	document.addEventListener('astro:before-swap', () => panelObserver?.disconnect());
	reducedMotion.addEventListener('change', () => {
		if (!reducedMotion.matches) return;
		panelObserver?.disconnect();
		document.querySelectorAll('[data-panel-motion]').forEach((panel) => panel.setAttribute('data-panel-visible', ''));
	});
</script>
