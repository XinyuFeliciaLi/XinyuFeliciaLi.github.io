---
// Project card — "lg" for the 4 featured projects, "sm" for Related / Playground.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	href?: string;
	image: ImageMetadata;
	title: string;
	meta?: string;
	tags?: string[];
	size?: 'lg' | 'sm';
}

const { href, image, title, meta, tags = [], size = 'lg' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['card', `card--${size}`, { 'card--link': href }]} href={href}>
	<div class="card__media">
		<Image src={image} alt="" widths={[320, 640, 960]} sizes={size === 'lg' ? '(max-width: 40rem) 92vw, 490px' : '(max-width: 40rem) 92vw, 330px'} />
	</div>
	<div class="card__body">
		<h3 class="card__title">{title}</h3>
		{meta && <p class="t-caption card__meta">{meta}</p>}
		{
			tags.length > 0 && (
				<ul class="card__tags" aria-label="Tags">
					{tags.map((t) => (
						<li>{t.trim()}</li>
					))}
				</ul>
			)
		}
	</div>
</Tag>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		text-decoration: none;
		color: inherit;
		border-radius: var(--radius-lg);
	}

	.card__media {
		transition:
			transform var(--duration-medium) var(--ease-standard),
			box-shadow var(--duration-medium) var(--ease-standard);
		background: var(--color-card);
		border-radius: var(--radius-lg);
		aspect-ratio: 450 / 253;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.card--sm .card__media {
		aspect-ratio: 308 / 204;
		border-radius: var(--radius-md);
	}

	.card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding-inline: var(--space-5);
	}

	.card--sm .card__body {
		padding-inline: var(--space-2);
	}

	.card__title {
		font: var(--type-subheading);
		font-weight: 600;
		margin: 0;
	}

	.card--sm .card__title {
		font: var(--type-lead);
	}

	.card__meta {
		margin: 0;
	}

	.card__tags {
		list-style: none;
		margin: var(--space-1) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	/* Figma tag: filled pill at 50% opacity, no outline, 14px (12px on the small cards) */
	.card__tags li {
		font: var(--type-small);
		color: var(--color-ink);
		padding: 6px 12px;
		border-radius: var(--radius-full);
		background: var(--color-card);
	}

	/* hover lifts only the image panel — the text area never gets a box or shadow */
	.card--link:hover .card__media {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px -14px rgb(37 55 70 / 0.3);
	}

	@media (prefers-reduced-motion: reduce) {
		.card--link:hover .card__media {
			transform: none;
		}
	}

	.card--sm .card__tags li {
		font: var(--type-caption);
		color: var(--color-ink);
		padding: 4px 10px;
	}

</style>
