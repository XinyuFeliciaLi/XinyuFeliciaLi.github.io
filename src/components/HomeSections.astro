---
// Everything on the landing page below the hero: projects, "Why Me?" and related projects.
// Shared by the home page and the hero sandbox.
import ProjectCard from './ProjectCard.astro';
import comingSoon from '../assets/home/card-coming-soon.png';
import { cases, cardImage, caseHref, hasPage } from '../data/cases';

const projects = cases.filter((c) => c.kind === 'project');
const related = cases.filter((c) => c.kind === 'playground');

// "Why Me?" — two rows of chips, each row flanked by a round dot, copy and colors as in Figma
const strengthRows = [
	{
		dots: ['#fccfe9', '#53bc90'],
		chips: [
			{ label: 'Product Thinking', color: '#5adba6' },
			{ label: 'Navigating Ambiguity', color: '#daf69c' },
			{ label: 'Effective Collaborator', color: '#fccfe9' },
		],
	},
	{
		dots: ['#dac8ff', '#a3d9ff'],
		chips: [
			{ label: 'Versatile UX/UI Designer', color: '#a3d9ff' },
			{ label: 'Ai Native Workflow', color: '#dac8ff' },
			{ label: 'Detail-Driven in Delivery', color: '#ff894b' },
		],
	},
];
---

<section class="container projects" aria-label="Projects">
	<ul class="grid grid--2">
		{
			projects.map((c) => (
				<li data-reveal>
					<ProjectCard
						href={hasPage(c.slug) ? caseHref(c) : undefined}
						image={cardImage(c.slug)}
						title={c.cardTitle}
						meta={c.cardMeta}
						tags={c.tags}
						tagBackground="rgb(247 248 249 / 0.55)"
					/>
				</li>
			))
		}
	</ul>
</section>

<section class="container why">
	<h2 data-reveal>My Strength</h2>
	<div class="chips" data-reveal>
		{
			strengthRows.map((row) => (
				<div class="chips__row">
					<span class="chips__dot" style={`--chip: ${row.dots[0]}`} aria-hidden="true" />
					<ul>
						{row.chips.map((c) => (
							<li class="chips__pill" style={`--chip: ${c.color}`}>
								<span class="chips__label">{c.label}</span>
							</li>
						))}
					</ul>
					<span class="chips__dot" style={`--chip: ${row.dots[1]}`} aria-hidden="true" />
				</div>
			))
		}
	</div>
</section>

<section class="container related">
	<h2 data-reveal>Related Projects</h2>
	<ul class="grid grid--3">
		{
			related.map((c) => (
				<li data-reveal>
					<ProjectCard
						size="sm"
						href={hasPage(c.slug) ? caseHref(c) : undefined}
						image={cardImage(c.slug)}
						title={c.cardTitle}
						tags={c.tags}
						tagBackground="rgb(248 249 250 / 0.55)"
					/>
				</li>
			))
		}
		<li data-reveal>
			<ProjectCard size="sm" image={comingSoon} title="Coming Soon" />
		</li>
	</ul>
</section>

<style>
	.projects {
		padding-top: var(--space-12);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-12) var(--space-10);
	}

	.grid--2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.grid--3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-10) var(--space-8);
	}

	/* Figma: ~180px between Projects, Why Me? and Related Projects */
	.why,
	.related {
		padding-top: 11.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-8);
	}

	.related .grid {
		width: 100%;
	}

	.why {
		text-align: center;
	}

	.why h2[data-reveal] {
		transform: none;
		filter: none;
		transition: opacity 650ms ease;
	}

	.chips[data-reveal] {
		opacity: 1;
		transform: none;
		filter: none;
		transition: none;
	}

	/* Figma: chips ~45px tall, 14px Medium uppercase, 28px dots at both ends of each row */
	.chips {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-5);
		width: min(100%, 62rem);
		margin-inline: auto;
	}

	.chips__row {
		display: grid;
		grid-template-columns: 28px minmax(0, 1fr) 28px;
		align-items: center;
		justify-content: center;
		width: 100%;
		gap: var(--space-6);
		--lane-delay: 120ms;
		--lane-start: -32px;
	}

	.chips__row:nth-child(2) {
		--lane-delay: 280ms;
		--lane-start: calc(-100% - var(--space-5) - 32px);
	}

	@media (prefers-reduced-motion: no-preference) {
		.chips[data-reveal] .chips__row {
			opacity: 0;
			transform: translateY(var(--lane-start));
			transition: transform 850ms cubic-bezier(0.22, 1, 0.36, 1), opacity 650ms ease;
			transition-delay: var(--lane-delay, 0ms);
		}

		.chips[data-reveal] .chips__label {
			opacity: 0;
			transition: opacity 650ms ease;
			transition-delay: calc(var(--lane-delay, 0ms) + 180ms);
		}

		.chips[data-revealed] .chips__row {
			opacity: 1;
			transform: none;
		}

		.chips[data-revealed] .chips__label {
			opacity: 1;
		}
	}

	.chips__row ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4) var(--space-6);
	}

	.chips__pill {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-width: 0;
		font: var(--type-label);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 0.8rem 1rem;
	}

	/* The decorative pill is independent of its selectable text label. */
	.chips__pill::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: var(--radius-full);
		background: var(--chip);
	}

	.chips__label {
		display: block;
		text-align: center;
	}

	.chips__dot {
		flex: none;
		width: 28px;
		height: 28px;
		border-radius: var(--radius-full);
		background: var(--chip);
	}

	@media (max-width: 52rem) {
		.chips__row {
			grid-template-columns: minmax(0, 1fr);
		}

		.chips__dot {
			display: none;
		}

		.chips__pill {
			padding: 0.6rem 0.75rem;
		}
	}

	@media (max-width: 52rem) {
		.grid--3 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.chips__row ul {
			grid-template-columns: minmax(0, 1fr);
			width: min(100%, 24rem);
			margin-inline: auto;
		}

		.why,
		.related {
			padding-top: var(--space-20);
		}

		.grid--2,
		.grid--3 {
			grid-template-columns: 1fr;
		}
	}
</style>
