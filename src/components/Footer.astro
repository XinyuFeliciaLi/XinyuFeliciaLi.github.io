---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p>&copy; {year} Felicia Li</p>
		<p>Designed and built with love and coffee</p>
	</div>
</footer>

<style>
	/* Navy band (Figma: 178px footer band) */
	.site-footer {
		margin-top: var(--space-24);
		background: var(--color-ink);
		color: var(--color-on-ink-80);
	}

	.site-footer__inner {
		min-height: 11.125rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		font: var(--type-small);
	}
</style>
