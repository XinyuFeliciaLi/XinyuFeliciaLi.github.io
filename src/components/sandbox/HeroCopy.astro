---
// The landing hero copy, word for word from index.astro, shared by every sandbox direction
import { Image } from 'astro:assets';
import avatar from '../../assets/home/avatar.jpg';
---

<div class="hero-copy">
	<p class="hero-copy__hello">
		Hello
		<Image src={avatar} alt="Felicia Li" width={32} height={32} class="hero-copy__avatar" />
		I&rsquo;m Felicia
	</p>
	<h1 class="t-display">
		<span class="hero-copy__line"><span>A product designer</span></span>{' '}
		<span class="hero-copy__line"><span>who puts people in control of technology</span></span>
	</h1>
	<p class="t-small">
		Designing and shipping <strong>B2C products</strong> &amp; <strong>AI experiences</strong><br />
		Previously at AlterStaff &middot; CMU Alum
	</p>
</div>

<style>
	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-4) * 2);
	}

	.hero-copy h1,
	.hero-copy p {
		margin: 0;
	}

	.hero-copy__line {
		display: block;
		overflow: clip;
		padding-block: 0.08em;
		margin-block: -0.08em;
	}

	.hero-copy__line > span { display: block; }

	@media (prefers-reduced-motion: no-preference) {
		.hero-copy__line > span {
			animation: hero-line-reveal 850ms cubic-bezier(0.22, 1, 0.36, 1) both;
			animation-delay: 180ms;
		}
		.hero-copy__line:nth-child(2) > span { animation-delay: 320ms; }
		.hero-copy__hello { animation: hero-copy-reveal 650ms ease-out both; }
		.hero-copy > .t-small { animation: hero-copy-reveal 700ms ease-out 500ms both; }
	}

	@keyframes hero-line-reveal {
		from { transform: translateY(110%); opacity: 0; }
		to { transform: translateY(0); opacity: 1; }
	}

	@keyframes hero-copy-reveal {
		from { transform: translateY(12px); opacity: 0; }
		to { transform: translateY(0); opacity: 1; }
	}

	.hero-copy__hello {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font: var(--type-body);
		font-size: 1.125rem;
	}

	.hero-copy__hello :global(.hero-copy__avatar) {
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-full);
		object-fit: cover;
	}
</style>
