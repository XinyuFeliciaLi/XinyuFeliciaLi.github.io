---
// Direction — "Dither light": a calmer retro dither. The whole hero is one soft gradient lit by a
// light that eases after the cursor (and drifts slowly when idle), Bayer 4×4 dithered into a few
// flat tones — closer to a 1-bit game screen than the blob lens. All tones are light, so the navy
// text stays legible wherever the light is.
import HeroCopy from './HeroCopy.astro';
---

<div class="dlight" data-dlight data-colors="mint">
	<canvas class="dlight__canvas" data-canvas aria-hidden="true"></canvas>
	<div class="dlight__content">
		<HeroCopy />
	</div>
	<div class="dlight__controls" role="group" aria-label="Dither light settings">
		<label>
			Pixel
			<input type="range" min="3" max="10" value="5" data-control="pixel" />
		</label>
		<label>
			Light
			<input type="range" min="20" max="90" value="45" data-control="light" />
		</label>
		<label>
			Colors
			<select data-control="colors">
				<option value="mint">Mint</option>
				<option value="palette">Palette</option>
				<option value="grey">Grey</option>
			</select>
		</label>
	</div>
</div>

<style>
	.dlight {
		position: relative;
		max-width: var(--width-hero);
		min-height: clamp(34rem, 35vw, 42rem);
		margin-inline: auto;
		display: grid;
		align-items: center;
		background: #5adba6;
		border-radius: clamp(var(--radius-lg), 4vw, 80px);
		overflow: hidden;
	}

	.dlight__canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	.dlight__content {
		position: relative;
		width: 100%;
		max-width: calc(var(--width-wide) + 2 * var(--space-6));
		margin-inline: auto;
		padding: calc(var(--space-10) + 5rem) var(--space-6) var(--space-12);
		pointer-events: none;
	}

	.dlight__controls {
		position: absolute;
		left: var(--space-6);
		bottom: var(--space-6);
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.dlight__controls label {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
		font: var(--type-caption);
		background: #fff;
		border-radius: var(--radius-sm);
		box-shadow: 0 4px 16px -8px rgb(37 55 70 / 0.35);
	}

	.dlight__controls input[type='range'] {
		width: 6.5rem;
		margin-right: var(--space-2);
		accent-color: var(--color-ink);
	}

	.dlight__controls select {
		font: var(--type-caption);
		font-weight: 500;
		color: inherit;
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--color-line);
		border-radius: 6px;
		background: #fff;
	}
</style>

<script>
	import { PALETTE_EVENT, currentPalette, onEachPage, reducedMotion, visibleLoop } from './shared';

	const FOLLOW = 0.06; // slow, calm easing toward the cursor
	const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
	const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));

	// Tone ramps, darkest (unlit) first, white (lit) last
	function ramp(key: string) {
		if (key === 'palette') {
			// The switcher palette's first two colours (e.g. pink + purple), lit up to white
			const pal = currentPalette();
			return [pal[1], pal[0], '#ffffff'].map(hex);
		}
		if (key === 'grey') return ['#c9cdd4', '#e4e6ea', '#f2f3f5', '#ffffff'].map(hex);
		return ['#5adba6', '#9fe9c9', '#d6f6e8', '#ffffff'].map(hex);
	}

	onEachPage('[data-dlight]', (root) => {
		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		let pixel = 5;
		let lightSize = 0.45; // light radius as a share of the hero width
		let tones = ramp(root.dataset.colors ?? 'mint');
		let w = 0;
		let h = 0;
		let frame: ImageData | null = null;

		const pointer = { x: 0, y: 0, inside: false };
		const light = { x: 0, y: 0 };

		function resize() {
			w = Math.max(1, Math.ceil(root.clientWidth / pixel));
			h = Math.max(1, Math.ceil(root.clientHeight / pixel));
			canvas.width = w;
			canvas.height = h;
			frame = ctx.createImageData(w, h);
			light.x = w * 0.7;
			light.y = h * 0.45;
		}

		function render(now: number) {
			if (!frame) return;
			const still = reducedMotion();
			// Idle: the light wanders slowly on the right, away from the text
			const tx = pointer.inside ? pointer.x : w * (0.68 + (still ? 0 : Math.sin(now * 0.00021) * 0.18));
			const ty = pointer.inside ? pointer.y : h * (0.5 + (still ? 0 : Math.cos(now * 0.00029) * 0.25));
			light.x += (tx - light.x) * (still ? 1 : FOLLOW);
			light.y += (ty - light.y) * (still ? 1 : FOLLOW);

			const radius = w * lightSize;
			const inv = 1 / (radius * radius);
			const levels = tones.length - 1;
			const px = frame.data;

			for (let y = 0, i = 0; y < h; y++) {
				const dy2 = (y - light.y) ** 2;
				// A faint sky: a little brighter toward the top
				const sky = 0.18 * (1 - y / h);
				for (let x = 0; x < w; x++, i += 4) {
					const lit = Math.exp(-((x - light.x) ** 2 + dy2) * inv * 2.2);
					const v = Math.min(1, lit + sky) * levels;
					const base = Math.floor(v);
					const tone = tones[Math.min(levels, base + (v - base > BAYER[(y & 3) * 4 + (x & 3)] ? 1 : 0))];
					px[i] = tone[0];
					px[i + 1] = tone[1];
					px[i + 2] = tone[2];
					px[i + 3] = 255;
				}
			}
			ctx.putImageData(frame, 0, 0);
		}

		const onMove = (e: PointerEvent) => {
			if ((e.target as HTMLElement).closest('.dlight__controls')) return;
			const rect = root.getBoundingClientRect();
			Object.assign(pointer, { x: (e.clientX - rect.left) / pixel, y: (e.clientY - rect.top) / pixel, inside: true });
		};
		const onLeave = () => {
			pointer.inside = false;
		};
		const retone = () => {
			tones = ramp(root.dataset.colors ?? 'mint');
		};
		const onInput = (e: Event) => {
			const control = e.target as HTMLInputElement | HTMLSelectElement;
			if (control.dataset.control === 'pixel') {
				pixel = Number(control.value);
				resize();
			}
			if (control.dataset.control === 'light') lightSize = Number(control.value) / 100;
			if (control.dataset.control === 'colors') {
				root.dataset.colors = control.value;
				retone();
			}
		};

		root.addEventListener('pointermove', onMove);
		root.addEventListener('pointerleave', onLeave);
		root.addEventListener('input', onInput);
		document.addEventListener(PALETTE_EVENT, retone);

		const ro = new ResizeObserver(resize);
		ro.observe(root);
		resize();
		const stop = visibleLoop(root, render);

		return () => {
			ro.disconnect();
			stop();
			document.removeEventListener(PALETTE_EVENT, retone);
		};
	});
</script>
