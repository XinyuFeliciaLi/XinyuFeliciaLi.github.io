---
import { Image } from 'astro:assets';
import HeroCopy from './HeroCopy.astro';
import { cases, cardImage, caseHref } from '../../data/cases';
const work = cases.filter(c => c.kind === 'project').slice(0, 2);
---
<div class="selected">
 <div class="selected__inner">
  <div class="selected__intro"><span class="selected__eyebrow">THOUGHTFUL DESIGN. REAL PRODUCTS.</span><HeroCopy /><a class="selected__cta" href="/projects/">View selected work <span aria-hidden="true">↗</span></a></div>
  <div class="selected__work" aria-label="Featured case studies">
   {work.map((project, i) => <a class="selected__card" href={caseHref(project)} style={`--angle: ${i === 0 ? -6 : 5}deg`}><span class="selected__number">0{i + 1} / SELECTED WORK</span><Image src={cardImage(project.slug)} alt={project.heroAlt} width={520} /><span class="selected__caption">{project.cardTitle}<span aria-hidden="true">↗</span></span></a>)}
  </div>
 </div>
</div>
<style>
.selected { max-width:var(--width-hero); margin:auto; border-radius:clamp(24px,4vw,80px); background:#fffefd; overflow:hidden; }
.selected__inner { max-width:66rem; margin:auto; padding:10rem 1.5rem 5rem; min-height:40rem; display:grid; grid-template-columns:1.25fr 1fr; align-items:center; gap:4rem; }
.selected__eyebrow { display:block; margin-bottom:1.5rem; font:var(--type-caption); letter-spacing:.1em; color:var(--color-ink-60); }
.selected__intro :global(h1) { font-size:clamp(2rem,3vw,2.6rem); letter-spacing:-.035em; line-height:1.25; }
.selected__cta { display:inline-flex; gap:1.5rem; margin-top:2rem; padding:12px 20px; background:var(--color-ink); color:white; border-radius:999px; text-decoration:none; font:var(--type-label); }
.selected__work { display:grid; grid-template-columns:1fr; padding:1rem; }
.selected__card { position:relative; grid-area:1/1; display:flex; flex-direction:column; gap:12px; padding:18px; background:white; border:1px solid #e8e6e2; border-radius:20px; text-decoration:none; box-shadow:0 16px 45px #25374610; transform:translateY(-45px) rotate(var(--angle)); transition:transform 300ms ease, box-shadow 300ms ease; }
.selected__card:nth-child(2) { margin-top:125px; margin-left:35px; transform:translateY(15px) rotate(var(--angle)); }
.selected__card:hover,.selected__card:focus-visible { z-index:2; transform:translateY(-15px) rotate(0); box-shadow:0 20px 50px #25374620; }
.selected__number { font:var(--type-caption); color:var(--color-ink-60); letter-spacing:.08em; }
.selected__card :global(img) { width:100%; height:150px; object-fit:contain; background:#fdfcfc; border-radius:10px; }
.selected__caption { display:flex; justify-content:space-between; gap:12px; font:var(--type-label); }
@media(max-width:48rem){.selected__inner{grid-template-columns:1fr;gap:3rem;padding-top:10rem}.selected__work{max-width:360px;margin:auto;width:100%;padding-bottom:2rem}}
@media(prefers-reduced-motion:reduce){.selected__card{transition:none}}
</style>
