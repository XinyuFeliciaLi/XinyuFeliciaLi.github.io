---
import FeliciaMark from './FeliciaMark.astro';
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
	{ href: '/resume/', label: 'Resume' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="site-header__inner">
		<a href="/" class="site-header__mark" aria-label="Felicia Li — Home"><FeliciaMark /></a>
		<button class="site-header__toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
				<path class="menu-icon" d="M4 6h16M4 12h16M4 18h16" />
				<path class="close-icon" d="m6 6 12 12M6 18 18 6" />
			</svg>
		</button>
		<nav id="primary-navigation" aria-label="Primary">
			<ul class="site-header__nav">
				{
					nav.map((item) => (
						<li>
							<a
								href={item.href}
								aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	let cleanupNavigation: (() => void) | undefined;
	function setupNavigation() {
		cleanupNavigation?.();
		const header = document.querySelector<HTMLElement>('.site-header');
		const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
		if (!header || !toggle) return;
		const controller = new AbortController();
		const { signal } = controller;
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
		};
		toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'), { signal });
		header.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false), { signal }));
		document.addEventListener('keydown', event => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		}, { signal });
		document.addEventListener('click', event => {
			if (!header.contains(event.target as Node)) setOpen(false);
		}, { signal });
		header.addEventListener('focusout', event => {
			if (!header.contains(event.relatedTarget as Node)) setOpen(false);
		}, { signal });
		window.matchMedia('(max-width: 40rem)').addEventListener('change', () => setOpen(false), { signal });
		cleanupNavigation = () => controller.abort();
	}
	setupNavigation();
	document.addEventListener('astro:page-load', setupNavigation);
	document.addEventListener('astro:before-swap', () => cleanupNavigation?.());
</script>

<style>
	.site-header__toggle { display: none; }
	.close-icon { display: none; }
	.site-header__toggle[aria-expanded='true'] .menu-icon { display: none; }
	.site-header__toggle[aria-expanded='true'] .close-icon { display: block; }
	/* Glass navigation bar: stays at the top, frosted over whatever scrolls beneath it */
	.site-header {
		position: fixed;
		inset: var(--space-6) 0 auto;
		z-index: 10;
		padding-inline: var(--space-4); /* same inset as the hero panel */
		pointer-events: none;
	}

	.site-header__inner {
		pointer-events: auto;
		width: 100%;
		max-width: 63rem;
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		padding: var(--space-3) var(--space-8);
		border-radius: var(--radius-full);
		background: rgb(255 255 255 / 0.45);
		border: 1px solid rgb(255 255 255 / 0.6);
		box-shadow:
			0 8px 32px -12px rgb(37 55 70 / 0.25),
			inset 0 1px 0 rgb(255 255 255 / 0.7);
		-webkit-backdrop-filter: blur(18px) saturate(180%);
		backdrop-filter: blur(18px) saturate(180%);
	}

	/* browsers without backdrop-filter get a solid, readable bar instead */
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.site-header__inner {
			background: rgb(255 255 255 / 0.95);
		}
	}

	.site-header__mark {
		display: grid;
		place-items: center;
		min-width: 44px;
		min-height: 44px;
		font: var(--type-subheading);
		font-weight: 600;
		text-decoration: none;
	}

	.site-header__nav {
		list-style: none;
		display: flex;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
	}

	.site-header__nav a {
		display: block;
		font: var(--type-small);
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		transition: background-color var(--duration-short) var(--ease-standard);
	}

	.site-header__nav a:hover {
		background: rgb(255 255 255 / 0.6);
	}

	.site-header__nav a[aria-current='page'] {
		background: var(--nav-highlight, #daf69c);
	}

	/* Match each destination's curtain animation. */
	.site-header__nav a[href='/'] { --nav-highlight: #dac8ff; }
	.site-header__nav a[href='/about/'] { --nav-highlight: #5adba6; }
	.site-header__nav a[href='/resume/'] { --nav-highlight: #a3d9ff; }

	@media (max-width: 40rem) {
		.site-header {
			inset-block-start: var(--space-4);
			z-index: 30;
		}

		.site-header__inner {
			flex-wrap: wrap;
			justify-content: space-between;
			gap: var(--space-1);
			border-radius: var(--radius-lg);
			padding: var(--space-2) var(--space-4);
		}

		.site-header__mark {
			display: grid;
			place-items: center;
			min-height: 44px;
		}

		.site-header nav {
			display: none;
			width: 100%;
			min-width: 0;
			max-height: calc(100dvh - 108px);
			overflow-y: auto;
		}

		.site-header__toggle {
			display: grid;
			place-items: center;
			width: 44px;
			height: 44px;
			padding: 0;
			border: 0;
			border-radius: var(--radius-full);
			background: transparent;
			color: inherit;
			cursor: pointer;
		}

		.site-header__toggle[aria-expanded='true'] + nav {
			display: block;
		}

		.site-header__nav {
			flex-direction: column;
			justify-content: flex-start;
			gap: 0;
		}

		.site-header__nav li {
			min-width: 0;
		}

		.site-header__nav a {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 44px;
			padding-inline: clamp(6px, 2vw, 12px);
			font-size: 14px;
		}
	}

.site-header[data-style='split'] .site-header__inner { background:none; border:0; box-shadow:none; backdrop-filter:none; -webkit-backdrop-filter:none; padding:0; }
.site-header[data-style='split'] .site-header__mark, .site-header[data-style='split'] nav { background:#fffdf8; border:1px solid #eae5dc; border-radius:999px; box-shadow:0 4px 20px #25374608; padding:10px 20px; }
.site-header[data-style='split'] nav { padding:6px; }
.site-header[data-style='editorial'] .site-header__inner { border:0; border-bottom:1px solid #e7e1d5; border-radius:0; box-shadow:none; background:rgb(255 253 248 / .96); padding:14px 0; backdrop-filter:none; -webkit-backdrop-filter:none; }
.site-header[data-style='editorial'] .site-header__nav a { border-radius:0; }
.site-header[data-style='editorial'] .site-header__nav a:hover, .site-header[data-style='editorial'] .site-header__nav a[aria-current='page'] { background:none; text-decoration:underline; text-underline-offset:6px; }
@media(max-width:40rem){.site-header[data-style='split'] .site-header__inner{gap:8px}.site-header[data-style='split'] .site-header__nav a{padding-inline:10px}}
</style>
