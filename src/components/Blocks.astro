---
// Renders case study content blocks. Every text block maps to one shared type role,
// so all case studies share the same title / heading / body / eyebrow format.
import { Image } from 'astro:assets';
import Runs from './Runs.astro';
import RollingStat from './RollingStat.astro';
import VideoPlayer from './VideoPlayer.astro';
import WorkflowFigure from './WorkflowFigure.astro';
import StakeholderIllustration from './StakeholderIllustration.astro';
import CompetitiveAnalysis from './CompetitiveAnalysis.astro';
import IterationComparison from './IterationComparison.astro';
import ConstraintIcon from './ConstraintIcon.astro';
import ResearchResults from './ResearchResults.astro';
import { blockImage, videoUrl, type Block } from '../data/cases';

interface Props {
	items: Block[];
}

const { items } = Astro.props;
const isIcon = (b: Block) => (b.w ?? 0) <= 48 && (b.h ?? 0) <= 48;
// Figma alignment and color, carried per block: centered text, blue headings, accent colors
const mods = (b: Block) => ({ center: b.center, blue: b.blue, muted: b.muted });
const tint = (b: Block) => (b.color ? `color: ${b.color}` : undefined);
const wideImage = (b: Block) => b.items?.find((i) => (i.t === 'img' || i.t === 'video') && (i.w ?? 0) > 760)?.w;
const text = (b?: Block) => b?.runs?.map((r) => r.s).join('').trim() ?? '';
const isDivider = (b: Block) => /^\.{3,}$/.test(text(b));
const personaKind = (b: Block) => {
	const src = b.cols?.[0]?.items[0]?.src;
	return src === 'childrens-museum/006.png' ? 'faculty' : src === 'childrens-museum/007.png' ? 'audience' : undefined;
};
const isMetadata = (b: Block) => b.t === 'row' && !!b.cols?.length && b.cols.every((c) =>
	c.items.length === 2 && c.items[0].t === 'h4' && c.items[1].t === 'small');
const isProcess = (b: Block) => b.cols?.some((c) => c.items.length === 1 && c.items[0].t === 'img' && isIcon(c.items[0]));
const isMediaRow = (b: Block) => b.t === 'row' && b.cols?.length === 2 && b.cols.some((c) => c.items.every((i) => i.t === 'img' || i.t === 'video'));
const isSplitPanel = (b: Block) => b.items?.length === 1 && isMediaRow(b.items[0]) && b.items[0].cols?.some((c) => c.items.some((i) => i.t === 'card'));
const cardMods = (b: Block) => ({
	'block-card--stakeholder': b.items?.[0]?.t === 'stakeholder-illustration',
	'block-card--tint': b.tint,
	'block-card--center': b.center,
	'block-card--band': b.band,
	'block-card--wide': wideImage(b),
	'block-card--summary': text(b.items?.[0]) === 'Challenge',
	'block-card--details': text(b.items?.[0]) === 'Role',
	'block-card--metadata': b.items?.length === 1 && isMetadata(b.items[0]),
	'block-card--feature': !b.center && b.items?.[0]?.t === 'img' && b.items[0].h === 44,
	'block-card--alignment': b.items?.[0]?.t === 'img' && b.items[0].w === 191 && b.items[0].h === 45,
	'block-card--reflection': !!b.center && b.items?.[0]?.t === 'img' && isIcon(b.items[0]),
	'block-card--process': b.items?.length === 1 && b.items[0].t === 'row' && isProcess(b.items[0]),
	'block-card--split': isSplitPanel(b),
});
// Videos play once their MP4 is added at src/assets/media/<slug>/<figma-node>.mp4; until then
// the poster frame from Figma is shown as a still.
---

{
	items.map((b) => {
		// bulleted / numbered text, as set in Figma
		if (b.lines) {
			const List = b.list === 'ol' ? 'ol' : 'ul';
			const role = b.t === 'small' ? 't-small' : b.t === 'caption' ? 't-caption' : b.t === 'h4' ? 't-lead' : 't-body';
			return (
				<List class:list={['block-list', role, mods(b)]} style={tint(b)}>
					{b.lines.map((line) => (
						<li>
							<Runs runs={line} />
						</li>
					))}
				</List>
			);
		}
		switch (b.t) {
			case 'stakeholder-illustration':
				return <StakeholderIllustration kind={b.alt ?? 'investor'} />;
			case 'competitive-analysis':
				return <CompetitiveAnalysis />;
			case 'iteration-comparison':
				return <IterationComparison kind={b.alt ?? 'hero'} />;
			case 'title':
				return (
					<h1 class:list={["t-title", mods(b)]} style={tint(b)}>
						<Runs runs={b.runs!} />
					</h1>
				);
			case 'eyebrow':
				return (
					<p class:list={["t-eyebrow", mods(b), { 'iteration-divider': isDivider(b) }]} style={tint(b)}>
						<Runs runs={b.runs!} />
					</p>
				);
			case 'h2':
				return (
					<h2 class:list={mods(b)} style={tint(b)}>
						<Runs runs={b.runs!} />
					</h2>
				);
			case 'h3':
				return (
					<h3 class:list={mods(b)} style={tint(b)}>
						<Runs runs={b.runs!} />
					</h3>
				);
			case 'h4':
				return (
					<h4 class:list={mods(b)} style={tint(b)}>
						<Runs runs={b.runs!} />
					</h4>
				);
			case 'label':
				return (
					<p class:list={['t-label-caps', mods(b)]} style={tint(b)}>
						<Runs runs={b.runs!} />
					</p>
				);
			case 'stat':
				return (
					<p class:list={["t-stat", mods(b)]} style={tint(b)}>
						<RollingStat text={b.runs!.map((r) => r.s).join('')} />
					</p>
				);
			case 'video': {
				const poster = blockImage(b.src!);
				const url = b.video ? videoUrl(b.video) : undefined;
				if (url) {
					return (
						<div class="block-video" style={`max-width: ${b.w}px`}>
							<VideoPlayer src={url} poster={poster?.src} label={b.alt || 'Project video'} />
						</div>
					);
				}
				return poster ? (
					<Image class="block-img" src={poster} alt={b.alt ?? ''} width={b.w} height={b.h} loading="lazy" style={`width: ${b.w}px`} />
				) : null;
			}
			case 'p':
				return (
					<p class:list={['t-body', mods(b)]} style={tint(b)}>
						<Runs runs={b.runs!} />
					</p>
				);
			case 'small':
				return (
					<p class:list={["t-small", mods(b)]} style={tint(b)}>
						<Runs runs={b.runs!} />
					</p>
				);
			case 'caption':
				return (
					<p class:list={["t-caption", mods(b)]} style={tint(b)}>
						<Runs runs={b.runs!} />
					</p>
				);
			case 'img': {
				if (b.src === 'ai2u-voice-chat/007.png') return <ResearchResults />;
				const constraint = ['fortune-kid/005.png', 'fortune-kid/006.png', 'fortune-kid/007.png'].indexOf(b.src ?? '');
				if (constraint !== -1) return <ConstraintIcon variant={constraint} />;
				const workflow = ['fortune-kid/017.png', 'fortune-kid/018.png', 'fortune-kid/019.png'].indexOf(b.src ?? '');
				if (workflow !== -1) return <WorkflowFigure variant={workflow + 1} />;
				const src = blockImage(b.src!);
				if (!src) return null;
				return isIcon(b) ? (
					<Image class:list={["block-icon", { center: b.center, right: b.right }]} src={src} alt="" width={b.w} height={b.h} loading="lazy" />
				) : (
					<Image
						class:list={["block-img", { center: b.center, 'block-img--backdrop': b.fill }]}
						src={src}
						alt={b.alt ?? ''}
						width={b.w}
						height={b.h}
						loading="lazy"
						style={`width: ${b.w}px;${b.fill ? `background: ${b.fill};` : ''}`}
					/>
				);
			}
			case 'showreel': {
				const src = blockImage(b.src!);
				return src ? <div class="block-showreel"><div class="showreel-media"><Image src={src} alt={b.alt ?? ''} width={b.w} height={b.h} loading="lazy" /></div></div> : null;
			}
			case 'card':
				return (
					<div
							class:list={['block-card', cardMods(b)]}
							style={[b.fill && `--fill: ${b.fill}`, wideImage(b) && `--wide: ${wideImage(b)! + 93}px`].filter(Boolean).join('; ') || undefined}
						>
						<Astro.self items={b.items!} />
					</div>
				);
			case 'pair':
				return (
					<div class="block-pair">
						<Astro.self items={b.items!} />
					</div>
				);
			case 'row': {
				// a row of single cards shares its inner rows, so titles, text and icons line up
				// across the cards even when one title wraps to two lines
				// (only when the cards are built the same way, e.g. icon + title + text in each)
				const shape = (c: { items: Block[] }) => c.items[0].items?.map((i) => i.t).join() ?? '';
				const cards =
					b.cols!.length > 1 &&
					b.cols!.every((c) => c.items.length === 1 && c.items[0].t === 'card') &&
					b.cols!.every((c) => shape(c) === shape(b.cols![0]));
				const rows = cards ? Math.max(...b.cols!.map((c) => c.items[0].items?.length ?? 1)) : 0;
				return (
					<div
						data-persona={personaKind(b)}
						data-media-source={b.cols?.flatMap((c) => c.items).find((i) => i.src)?.src}
						data-card-group={cards ? text(b.cols![0].items[0].items?.find((i) => i.runs)) : undefined}
						class:list={['block-row', { 'block-row--aligned': cards, 'block-row--metadata': isMetadata(b), 'block-row--process': isProcess(b), 'block-row--media': isMediaRow(b), 'block-row--compact': cards && b.cols!.every((c) => shape(c) === 'label,caption') }]}
						style={[`--columns: ${b.cols!.map((c) => `minmax(${isProcess(b) ? 'min-content' : '0'}, ${c.w}fr)`).join(' ')}`, cards && `--rows: ${rows}`].filter(Boolean).join('; ')}
					>
						{b.cols!.map((c, index) => (
							<div class:list={['block-col', { 'block-col--media-panel': !personaKind(b) && b.cols!.length === 2 && c.items.length === 1 && ['img', 'video'].includes(c.items[0].t) && (c.items[0].w ?? 0) > 250 && b.cols![1 - index].items.some((i) => !['img', 'video'].includes(i.t)) }]} style={c.items[0]?.w && c.items[0]?.h ? `--media-ratio: ${c.items[0].h / c.items[0].w * 100}%` : undefined}>
								<Astro.self items={c.items} />
							</div>
						))}
					</div>
				);
			}
			default:
				return null;
		}
	})
}
