---
import AnimatedImage from './AnimatedImage.astro';
import heroBefore from '../assets/iteration/hero-before.png';
import heroAfter from '../assets/iteration/hero-after.png';
import gameBefore from '../assets/iteration/game-before.png';
import gameAfter from '../assets/iteration/game-after.png';
interface Props { kind: string }
const { kind } = Astro.props;
const hero = kind === 'hero';
const images = hero ? [heroBefore, heroAfter] : [gameBefore, gameAfter];
---
<div class:list={['iteration-comparison', { 'iteration-comparison--hero': hero }]}>
 {images.map((src, i) => <figure>
  <div class="iteration-image"><AnimatedImage class="iteration-media" src={src} alt={`${hero ? 'Studio landing page' : 'Game information page'} ${i === 0 ? 'before' : 'after'} iteration`} loading="lazy" /></div>
  <figcaption>{i === 0 ? 'Before' : 'After'}</figcaption>
 </figure>)}
</div>
<style>
 .iteration-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; padding: 16px 4px; margin-top: 12px; background: var(--case-fill-workflow); border-radius: 16px; }
 figure { margin: 0; min-width: 0; }
 .iteration-image { position: relative; aspect-ratio: 355 / 176; overflow: hidden; border-radius: var(--radius-design); }
 .iteration-image > :global(.iteration-media) { position: absolute; width: 100%; height: 100%; object-fit: cover; }
 .iteration-comparison--hero figure:first-child :global(.iteration-media) { height: 115.12%; top: -9.99%; }
 .iteration-comparison--hero figure:last-child :global(.iteration-media) { height: 113.82%; top: -8.83%; }
 figcaption { margin-top: 4px; text-align: center; font: 400 12px / 17px var(--font-sans); color: var(--color-ink); }
 @media(max-width:40rem) { .iteration-comparison { gap: 12px; } }
</style>
