<div id="project-curtain" transition:persist="project-curtain" aria-hidden="true"></div>

<style is:global>
	#project-curtain { position: fixed; inset: 0; z-index: 2147483647; display: flex; overflow: hidden; pointer-events: none; visibility: hidden; }
	#project-curtain[data-active] { visibility: visible; pointer-events: auto; }
	#project-curtain > i { display: block; flex: 1; height: 100%; margin-right: -1px; background: var(--curtain-color, #daf69c); will-change: transform; }
	#project-curtain > .curtain-name { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; padding: 24px; color: #f7f7f2; font-family: var(--font-sans); font-size: clamp(2.75rem, 8vw, 7rem); font-weight: 600; letter-spacing: -0.065em; line-height: 1.1; white-space: nowrap; opacity: 0; }
</style>

<script>
	import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client';

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	let active: { overlay: HTMLElement; animations: Animation[]; reverse: boolean; timer: number; signal: AbortSignal; abort: () => void } | undefined;

	function clear() {
		if (!active) return;
		const current = active;
		active = undefined;
		clearTimeout(current.timer);
		current.signal.removeEventListener('abort', current.abort);
		current.animations.forEach(animation => animation.cancel());
		current.overlay.removeAttribute('data-active');
		current.overlay.replaceChildren();
	}

	function animate(reveal: boolean) {
		const current = active!;
		const panels = Array.from(current.overlay.querySelectorAll('i'));
		const sign = current.reverse ? -1 : 1;
		const animations = panels.map((panel, index) => panel.animate([
			{ transform: `translateY(${reveal ? 0 : -sign * 101}%)` },
			{ transform: `translateY(${reveal ? sign * 101 : 0}%)` },
		], {
			duration: 270,
			delay: (current.reverse ? panels.length - 1 - index : index) * 110 / (panels.length - 1),
			easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'both',
		}));
		const name = current.overlay.querySelector('.curtain-name')!;
		animations.push(name.animate(reveal
			? [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-8px)' }]
			: [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
			{ duration: reveal ? 120 : 180, delay: reveal ? 0 : 220, easing: 'ease-out', fill: 'both' }));
		current.animations.push(...animations);
		return Promise.allSettled(animations.map(animation => animation.finished));
	}

	document.addEventListener('astro:before-preparation', (event) => {
		const e = event as TransitionBeforePreparationEvent;
		clear();
		if (e.from.pathname === e.to.pathname) return;
		// Site navigation and explicit project return links share the same wipe.
		const relevant = e.navigationType !== 'traverse' && !!e.sourceElement?.closest('.site-header a, a[data-project-navigation]');
		if (!relevant || reducedMotion.matches) return;
		const overlay = document.getElementById('project-curtain')!;
		const destination = e.to.pathname.replace(/\/$/, '');
		const color = destination === '' ? '#dac8ff' : destination === '/about' ? '#5adba6' : destination === '/resume' ? '#a3d9ff' : '#daf69c';
		overlay.style.setProperty('--curtain-color', color);
		const count = Math.max(4, Math.min(12, Math.ceil(innerWidth / 120)));
		overlay.replaceChildren(...Array.from({ length: count }, () => document.createElement('i')));
		const name = document.createElement('span');
		name.className = 'curtain-name';
		const labels: Record<string, string> = { '': 'HOME', '/projects': 'PROJECTS', '/about': 'ABOUT', '/resume': 'RESUME' };
		name.textContent = labels[destination] ?? 'HOME';
		overlay.append(name);
		overlay.setAttribute('data-active', '');
		active = { overlay, animations: [], reverse: false,
			timer: window.setTimeout(clear, 8000), signal: e.signal, abort: clear };
		e.signal.addEventListener('abort', clear, { once: true });
		const current = active;
		const cover = animate(false);
		const loader = e.loader;
		// Fetch the destination while the panels cover the current page.
		e.loader = async () => {
			try { await Promise.all([loader(), cover]); }
			catch (error) { if (active === current) clear(); throw error; }
			if ((e.defaultPrevented || e.signal.aborted) && active === current) clear();
		};
	});

	document.addEventListener('astro:before-swap', (event) => {
		if (!active) return;
		const transition = (event as TransitionBeforeSwapEvent).viewTransition;
		// Skipping the browser crossfade intentionally rejects its ready promise.
		void transition.ready.catch(() => {});
		transition.skipTransition();
	});
	document.addEventListener('astro:page-load', () => {
		if (!active) return;
		const current = active;
		requestAnimationFrame(() => {
			if (active !== current) return;
			void animate(true).then(() => { if (active === current) clear(); });
		});
	});
	// Avoid stacking clicks while allowing browser history to interrupt safely.
	document.addEventListener('click', (event) => {
		if (active && event.target instanceof Element && event.target.closest('a')) {
			event.preventDefault(); event.stopImmediatePropagation();
		}
	}, true);
	reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) clear(); });
	window.addEventListener('pagehide', clear);
</script>
