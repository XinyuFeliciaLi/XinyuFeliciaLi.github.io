---
import poses from '../data/landing-intro-poses.json';
// Vector contours traced from 1012-Logo Website-2; no video is loaded.
---

<div id="landing-intro" hidden aria-hidden="true">
  <div class="landing-intro__curtains">
    {Array.from({ length: 8 }, () => <div class="landing-intro__panel" />)}
  </div>
  <canvas class="landing-intro__logo"></canvas>
</div>

<style>
  #landing-intro { position: fixed; inset: 0; z-index: 10000; overflow: hidden; }
  #landing-intro[hidden] { display: none; }
  .landing-intro__curtains { position: absolute; inset: 0; display: flex; }
  .landing-intro__panel { flex: 1; margin-right: -1px; background: #F3F3F5; will-change: transform; }
  .landing-intro__logo { position: absolute; top: 50%; left: 50%; width: min(345px, 74vw); height: min(345px, 74vw); transform: translate(-50%, -50%); }
  :global(html[data-landing-intro]) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { #landing-intro { display: none; } }
</style>

<script define:vars={{ poses }} data-astro-rerun>
  (() => {
    const root = document.getElementById('landing-intro');
    if (!root) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Document-local flag: refresh replays; Astro client navigation does not.
    if (window.__feliciaIntroPlayed || reducedMotion.matches) { root.remove(); return; }

    const canvas = root.querySelector('canvas');
    const ctx = canvas.getContext('2d');
    if (!ctx || typeof Path2D === 'undefined') { root.remove(); return; }
    window.__feliciaIntroPlayed = true;

    let frame = 0;
    let deadline = 0;
    let finished = false;
    const animations = [];
    const html = document.documentElement;
    const main = root.closest('main');
    const wasInert = main?.inert;
    const blockTab = (event) => { if (event.key === 'Tab') event.preventDefault(); };
    const finish = () => {
      if (finished) return;
      finished = true;
      cancelAnimationFrame(frame);
      clearTimeout(deadline);
      animations.forEach((animation) => animation.cancel());
      html.removeAttribute('data-landing-intro');
      if (main) main.inert = wasInert;
      root.remove();
      window.removeEventListener('resize', resize);
      window.removeEventListener('pagehide', finish);
      document.removeEventListener('astro:before-swap', finish);
      document.removeEventListener('keydown', blockTab, true);
      reducedMotion.removeEventListener('change', finish);
    };
    let paths;
    let currentPose = 0;
    function draw() {
      ctx.clearRect(0, 0, 360, 360);
      for (const [path, hole] of paths[currentPose]) {
        ctx.fillStyle = hole ? '#F3F3F5' : '#2C2C2C';
        ctx.fill(path);
      }
    }
    function resize() {
      const size = canvas.getBoundingClientRect().width;
      const pixels = Math.round(size * Math.max(2, Math.min(window.devicePixelRatio || 1, 3)));
      canvas.width = pixels;
      canvas.height = pixels;
      ctx.setTransform(pixels / 360, 0, 0, pixels / 360, 0, 0);
      draw();
    }

    try {
      paths = poses.slice(0, 34).map((pose) => pose.map(([d, hole]) => [new Path2D(d), hole]));
      root.hidden = false;
      html.setAttribute('data-landing-intro', '');
      if (main) main.inert = true;
      document.addEventListener('keydown', blockTab, true);
      resize();
      const start = performance.now();
      deadline = window.setTimeout(finish, 1400);
      root.querySelectorAll('.landing-intro__panel').forEach((panel, index) => {
        animations.push(panel.animate(
          [{ transform: 'translateY(0)' }, { transform: 'translateY(-100%)' }],
          { duration: 375, delay: 850 + index * 25, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'forwards' }
        ));
      });
      animations.push(canvas.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 90, delay: 850, fill: 'forwards'
      }));
      const tick = (now) => {
        const elapsed = Math.max(0, now - start);
        if (elapsed >= 1400) { finish(); return; }
        currentPose = Math.min(paths.length - 1, Math.floor(Math.min(elapsed, 850) / 850 * (paths.length - 1)));
        draw();
        if (elapsed < 940) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
      window.addEventListener('resize', resize);
      window.addEventListener('pagehide', finish, { once: true });
      document.addEventListener('astro:before-swap', finish, { once: true });
      reducedMotion.addEventListener('change', finish, { once: true });
    } catch { finish(); }
  })();
</script>
